{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun", "node"],
    "paths": {
      "@u7-scl/core/domain": ["./platform/core/src/domain/index.ts"],
      "@u7-scl/core/api": ["./platform/core/src/api/index.ts"],
      "@u7-scl/core/ui": ["./platform/core/src/ui/index.ts"],
      "@u7-scl/core/shared": ["./platform/core/src/shared/index.ts"],
      "@u7-scl/course": ["./modules/course/src/index.ts"],
      "@u7-scl/stream": ["./modules/stream/src/index.ts"],
      "@u7-scl/domain": ["./domain/src/index.ts"],
      "@u7-scl/domain/*/contract": ["./domain/src/*/contract.ts"],
      "@u7-scl/domain/*": ["./domain/src/*/index.ts"],
      "@u7-scl/wish": ["./modules/wish/src/index.ts"],
      "@u7-scl/wish/infra": ["./modules/wish/src/infra/index.ts"],
      "@u7-scl/questionnaire": ["./modules/questionnaire/src/index.ts"],
      "@u7-scl/questionnaire/api": ["./modules/questionnaire/src/api/index.ts"],
      "@u7-scl/questionnaire/infra": [
        "./modules/questionnaire/src/infra/index.ts"
      ],
      "@u7-scl/w3school": ["./authoring/w3school/src/index.ts"],
      "@u7-scl/app": ["./platform/app/src/index.ts"],
      "@u7-scl/app-legacy": ["./platform/app-legacy/src/index.ts"],
      "@u7-scl/app-legacy/domain": [
        "./platform/app-legacy/src/domain/index.ts"
      ],
      "@u7-scl/bot/u7-bot-controller": [
        "./runners/u7-bot/src/core/u7-bot-controller.ts"
      ],
      "@u7-scl/bot/u7-bot-ui-story": [
        "./runners/u7-bot/src/core/u7-bot-ui-story.ts"
      ],
      "@u7-scl/bot/u7-bot-app-meta": [
        "./runners/u7-bot/src/core/u7-bot-app-meta.ts"
      ],
      "@u7-scl/bot/dispatch-uc": ["./runners/u7-bot/src/core/dispatch-uc.ts"],
      "@u7-scl/bot/u7-menu": ["./runners/u7-bot/src/core/u7-menu.ts"],
      "@u7-scl/bot/app/*": ["./runners/u7-bot/src/controllers/app/*"],
      "@u7-scl/bot/courses/*": ["./runners/u7-bot/src/controllers/courses/*"],
      "@u7-scl/bot/streams/*": ["./runners/u7-bot/src/controllers/streams/*"],
      "@u7-scl/bot/school/*": ["./runners/u7-bot/src/controllers/school/*"],
      "@u7-scl/bot/learning/*": ["./runners/u7-bot/src/controllers/learning/*"],
      "@u7-scl/bot/mentor/*": ["./runners/u7-bot/src/controllers/mentor/*"],
      "@u7-scl/test-helpers/*": ["./runners/u7-bot/tests/helpers/*"]
    }
  },
  "exclude": ["data/deploy/archive"]
}
