- packages/core/src/ui/bot/bot-controller.ts
- packages/core/src/ui/bot/ui-app.ts
- apps/u7-bot/src/core/ui-app.ts
- packages/core/src/ui/bot/ui-app.test.ts
- apps/u7-bot/src/core/ui-app.test.ts
