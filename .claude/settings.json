{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^(migrator|dmg-domain-author|dmg-api-author)$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun run scripts/agent-gate.ts",
            "timeout": 300,
            "statusMessage": "agent-gate: проверка затронутых пакетов"
          }
        ]
      }
    ]
  }
}
