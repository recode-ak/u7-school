{
  "name": "dmg-core",
  "version": "0.1.0",
  "description": "Платформа DMG (Domain Manifest Graph): манифесты, агрегаты, use-case, события, фасады и проверка архитектуры.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": ">=1.2"
  },
  "files": [
    "src",
    "!src/{app,arch,cli,domain,gen,graph,kernel}/**/*.test.ts",
    "!src/testing/*.test.ts",
    "docs",
    "skills",
    "agents",
    "llms.txt",
    "biome-plugins"
  ],
  "bin": {
    "dmg-core": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app/index.ts",
    "./graph": "./src/graph/index.ts",
    "./arch": "./src/arch/index.ts",
    "./cli": "./src/cli/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/example/*": "./src/testing/example/*.ts"
  },
  "imports": {
    "#core/*": "./src/*.ts"
  },
  "peerDependencies": {
    "@valibot/to-json-schema": "^1.7.1",
    "valibot": "^1.5.0"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check . --write",
    "tslint": "tsc --noEmit",
    "check": "bun run lint && bun run tslint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
