{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": true,
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noNonNullAssertedOptionalChain": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/**", "#*-legacy/**"],
                    "message": "ARC-10: платформа DMG не импортирует legacy и @u7-scl/* — мосты живут в legacy-bridge"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/kernel/**",
        "src/domain/**",
        "src/testing/example/todo/**",
        "src/testing/example/users/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#*-legacy/**", "@u7-scl/**"],
                    "message": "ARC-10: платформа DMG не импортирует legacy и @u7-scl/* — мосты живут в legacy-bridge"
                  },
                  {
                    "group": [
                      "#core/app/**",
                      "#core/graph/**",
                      "#core/arch/**",
                      "dmg-core/*"
                    ],
                    "message": "ARC-11: ядро и домен DMG не импортируют исполнение (app), граф и проверки (arch)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/testing/example/app/**",
        "!**/*.test.ts",
        "!**/infra/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/**", "#*-legacy/**"],
                    "message": "ARC-10: платформа DMG не импортирует legacy и @u7-scl/* — мосты живут в legacy-bridge"
                  },
                  {
                    "group": ["**/*.state", "**/state"],
                    "message": "DOM-01: entity видят только Ar своего агрегата и рендереры UI; используй доменный API"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/kernel/**",
        "src/domain/**",
        "src/testing/example/todo/**",
        "src/testing/example/users/**",
        "!**/*.test.ts"
      ],
      "plugins": ["./biome-plugins/dom-14-no-clock.grit"]
    },
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "plugins": [
        "./biome-plugins/arc-09-no-env.grit",
        "./biome-plugins/code-02-class-members.grit"
      ]
    },
    {
      "includes": [
        "src/**",
        "!**/*.test.ts",
        "!**/*.repo.ts",
        "!**/*.json-repo.ts",
        "!**/infra/**",
        "!src/app/app.fixture.ts",
        "!src/domain/aggregate/aggregate.ts"
      ],
      "plugins": ["./biome-plugins/dom-17-snapshot-repo-only.grit"]
    },
    {
      "includes": ["src/**", "!**/*.test.ts", "!src/kernel/fields/fields.ts"],
      "plugins": ["./biome-plugins/dom-12-no-iso-dates.grit"]
    },
    {
      "includes": ["src/testing/example/**/*.state.ts"],
      "plugins": ["./biome-plugins/dom-11-base-fields.grit"]
    },
    {
      "includes": [
        "src/testing/example/**/*.ar.ts",
        "src/testing/example/**/*.dcs.ts",
        "src/testing/example/**/*.facade.ts",
        "src/testing/example/**/*.uc.ts",
        "src/testing/example/**/*.er.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./biome-plugins/err-01-no-throw.grit"]
    },
    {
      "includes": [
        "src/testing/example/**/*.ar.ts",
        "src/testing/example/**/*.dcs.ts",
        "src/testing/example/**/*.facade.ts",
        "src/testing/example/**/*.uc.ts",
        "src/testing/example/**/*.er.ts",
        "src/testing/example/**/*.job.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./biome-plugins/api-02-no-manual-publish.grit"]
    }
  ]
}
