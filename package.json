{
  "name": "u7-school",
  "version": "0.3.2",
  "module": "index.ts",
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@valibot/to-json-schema": "^1.7.1",
    "markdown-to-telegram": "^0.0.7",
    "openai": "^6.49.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "@types/markdown-it": "^14.2.0",
    "dmg-core": "git+ssh://git@github.com/recode-ak/dmg-core.git#v0.3.0"
  },
  "private": true,
  "scripts": {
    "test": "bun test",
    "test:bot": "bun test runners/u7-bot/",
    "gen:e2e": "bun test ./scripts/gen-e2e.e2e.ts",
    "backup": "bash scripts/backup.sh",
    "backup:adhoc": "bash scripts/backup-adhoc.sh",
    "release": "bash scripts/release.sh",
    "dmg:sync": "dmg-core sync",
    "dmg:check": "dmg-core sync --check",
    "agents:sync": "bun run scripts/agents-sync.ts",
    "agents:check": "bun run scripts/agents-sync.ts --check",
    "arch:check": "bun run scripts/arch-check.ts",
    "gen": "dmg-core gen",
    "oplog": "bun run scripts/oplog.ts",
    "deploy": "bash scripts/deploy.sh",
    "migrate:streams-school-id": "bun run scripts/migrate-streams-school-id.ts",
    "seed:fixtures": "bun run runners/u7-bot/scripts/seed-fixtures.ts",
    "world:check": "bun run runners/u7-bot/scripts/world-check.ts",
    "world:list": "bun run runners/u7-bot/scripts/world-list.ts",
    "dev:fixtures": "bun run seed:fixtures && DB_DIR=./data/fixtures NODE_ENV=development bun run runners/u7-bot/src/main.ts",
    "test:w": "bash -c 'bun run --cwd \"${0}\" test'",
    "lint": "bunx biome check .",
    "lint:w": "bash -c 'bun run --cwd \"${0}\" lint'",
    "format": "bunx biome check . --write",
    "tslint": "tsc --noEmit",
    "tslint:w": "bash -c 'bun run --cwd \"${0}\" tslint'",
    "check": "bun run dmg:check && bun run agents:check && bun run lint && bun run tslint && bun run arch:check && bun run gen:e2e && bun test",
    "check:w": "bash -c 'bun run --cwd \"${0}\" check'",
    "start:prod": "pm2 start pm2.config.cjs --env production",
    "start:prod:stop": "pm2 stop pm2.config.cjs",
    "start:prod:restart": "pm2 restart pm2.config.cjs --update-env"
  },
  "type": "module",
  "workspaces": [
    "platform/*",
    "domain",
    "modules/*",
    "runners/*",
    "authoring/*"
  ]
}
