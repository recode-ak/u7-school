      "includes": ["modules/user/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/course", "@u7-scl/course/**"],
                    "message": "ARC-06: пакет user не импортирует пакет course; связь — через фасад домена"
