          }
        }
      }
    },
    {
      "includes": ["platform/app-legacy/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@u7-scl/**",
                      "!@u7-scl/core",
                      "!@u7-scl/core/**",
                      "!@u7-scl/domain",
                      "!@u7-scl/domain/**"
                    ],
                    "message": "ARC-07: app-legacy импортирует только core и domain"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["platform/app/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@u7-scl/domain",
                      "@u7-scl/domain/**",
                      "!@u7-scl/domain/*/contract",
                      "!@u7-scl/domain/shared",
                      "!@u7-scl/domain/shared/**"
                    ],
                    "message": "ARC-07: корень сборки берёт домен модуля только через контракт (@u7-scl/domain/<m>/contract), общий домен — shared (D-53)"
                  },
                  {
                    "group": ["@u7-scl/peer-review/**"],
                    "message": "ARC-07: корень сборки берёт прикладной пакет peer-review только через вход @u7-scl/peer-review (фабрика, репозитории)"
                  },
                  {
                    "group": ["@u7-scl/questionnaire/**"],
                    "message": "ARC-07: корень сборки берёт прикладной пакет questionnaire только через вход @u7-scl/questionnaire (фабрика, репозитории)"
                  },
                  {
                    "group": ["@u7-scl/stream/**"],
                    "message": "ARC-07: корень сборки берёт прикладной пакет stream только через вход @u7-scl/stream (фабрика, репозитории)"
                  },
                  {
                    "group": ["@u7-scl/wish/**"],
                    "message": "ARC-07: корень сборки берёт прикладной пакет wish только через вход @u7-scl/wish (фабрика, репозитории)"
                  },
                  {
                    "group": ["@u7-scl/course/**"],
                    "message": "ARC-07: корень сборки берёт прикладной пакет course только через вход @u7-scl/course (фабрика, репозитории)"
                  }
                ]
              }
            }
          }
        }
      }
