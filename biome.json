      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/course", "@u7-scl/course/**"],
                    "message": "ARC-06: пакет questionnaire не импортирует пакет course; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/dossier", "@u7-scl/dossier/**"],
