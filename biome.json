                    "group": ["@u7-scl/course", "@u7-scl/course/**"],
                    "message": "ARC-06: пакет stream не импортирует пакет course; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/dossier", "@u7-scl/dossier/**"],
                    "message": "ARC-06: пакет stream не импортирует пакет dossier; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/peer-review", "@u7-scl/peer-review/**"],
                    "message": "ARC-06: пакет stream не импортирует пакет peer-review; связь — через фасад домена"
                  },
                  {
                    "group": [
                      "@u7-scl/questionnaire",
                      "@u7-scl/questionnaire/**"
                    ],
                    "message": "ARC-06: пакет stream не импортирует пакет questionnaire; связь — через фасад домена"
                  },
