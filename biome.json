                  },
                  {
                    "group": [
                      "@u7-scl/questionnaire",
                      "@u7-scl/questionnaire/**"
                    ],
                    "message": "ARC-06: пакет dossier не импортирует пакет questionnaire; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/stream", "@u7-scl/stream/**"],
                    "message": "ARC-06: пакет dossier не импортирует пакет stream; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/user", "@u7-scl/user/**"],
                    "message": "ARC-06: пакет dossier не импортирует пакет user; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/wish", "@u7-scl/wish/**"],
