    {
      "includes": ["runners/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@u7-scl/*/infra",
                      "@u7-scl/*/infra/**",
                      "**/*.repo",
                      "**/*-repo",
                      "!@u7-scl/core",
                      "!@u7-scl/core/**",
                      "!@u7-scl/core/infra",
                      "!@u7-scl/core/infra/**",
                      "!@u7-scl/app-legacy/infra",
                      "!@u7-scl/app-legacy/infra/**",
                      "!./**",
                      "!../**"
                    ],
                    "message": "ARC-08: apps работают через appApi; репозитории и реализации модулей не импортируют"
                  }
                ]
              }
            }
          }
        }
      }
