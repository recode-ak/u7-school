                  },
                  {
                    "group": ["@u7-scl/stream", "@u7-scl/stream/**"],
                    "message": "ARC-06: пакет questionnaire не импортирует пакет stream; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/user", "@u7-scl/user/**"],
