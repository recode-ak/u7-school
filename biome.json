{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**"],
    "maxSize": 5242880
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noNonNullAssertedOptionalChain": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["runners/u7-bot/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["data/fullstack-js/**/mentor-files/**/manifest.json"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["data/fullstack-js/**/mentor-files/**/*.js"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noSelfCompare": "off",
            "noDoubleEquals": "off"
          },
          "correctness": {
            "useIsNan": "off",
            "noConstantCondition": "off",
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off",
            "noInnerDeclarations": "off"
          },
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "authoring/w3school/src/**",
        "authoring/video-summarizer/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["platform/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@u7-scl/**",
                      "!@u7-scl/core",
                      "!@u7-scl/core/**"
                    ],
                    "message": "ARC-01: core не импортирует domain, app и модули"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["domain/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!@u7-scl/core",
                      "!@u7-scl/core/**",
                      "!@u7-scl/domain/**",
                      "!valibot",
                      "!.",
                      "!./**",
                      "!../**",
                      "!dmg-core"
                    ],
                    "message": "ARC-02: domain импортирует только корень dmg-core (ядро и define*), core по долгу и valibot"
                  },
                  {
                    "group": [
                      "@u7-scl/domain/*/state",
                      "@u7-scl/domain/**/*.state"
                    ],
                    "message": "DOM-01: state чужого модуля не импортируется — только его contract (D-39, D-45)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "domain/**/*.policy.ts",
        "domain/**/*.rules.ts",
        "domain/**/*.dcs.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!@u7-scl/core",
                      "!@u7-scl/core/**",
                      "!@u7-scl/domain/**",
                      "!valibot",
                      "!.",
                      "!./**",
                      "!../**",
                      "!dmg-core"
                    ],
                    "message": "ARC-02: domain импортирует только корень dmg-core (ядро и define*), core по долгу и valibot"
                  },
                  {
                    "group": ["**/*.state", "**/state"],
                    "message": "DOM-01: entity видят только Ar своего агрегата, Def контрактов своего модуля и рендереры UI (D-39); используй доменный API"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["modules/course/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/dossier", "@u7-scl/dossier/**"],
                    "message": "ARC-06: пакет course не импортирует пакет dossier; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/peer-review", "@u7-scl/peer-review/**"],
                    "message": "ARC-06: пакет course не импортирует пакет peer-review; связь — через фасад домена"
                  },
                  {
                    "group": [
                      "@u7-scl/questionnaire",
                      "@u7-scl/questionnaire/**"
                    ],
                    "message": "ARC-06: пакет course не импортирует пакет questionnaire; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/stream", "@u7-scl/stream/**"],
                    "message": "ARC-06: пакет course не импортирует пакет stream; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/user", "@u7-scl/user/**"],
                    "message": "ARC-06: пакет course не импортирует пакет user; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/wish", "@u7-scl/wish/**"],
                    "message": "ARC-06: пакет course не импортирует пакет wish; связь — через фасад домена"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["modules/dossier/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/course", "@u7-scl/course/**"],
