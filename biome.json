                  },
                  {
                    "group": ["@u7-scl/wish", "@u7-scl/wish/**"],
                    "message": "ARC-06: пакет user не импортирует пакет wish; связь — через фасад домена"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["modules/wish/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["@u7-scl/course", "@u7-scl/course/**"],
                    "message": "ARC-06: пакет wish не импортирует пакет course; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/dossier", "@u7-scl/dossier/**"],
                    "message": "ARC-06: пакет wish не импортирует пакет dossier; связь — через фасад домена"
                  },
                  {
                    "group": ["@u7-scl/peer-review", "@u7-scl/peer-review/**"],
