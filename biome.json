    {
      "includes": ["domain/**", "!**/*.test.ts"],
      "plugins": ["./node_modules/dmg-core/biome-plugins/dom-14-no-clock.grit"]
    },
    {
      "includes": ["domain/**", "!**/*.test.ts"],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/code-02-class-members.grit"
      ]
    },
    {
      "includes": [
        "domain/**",
        "platform/*/src/**",
        "modules/*/src/**",
        "runners/*/src/**",
        "!runners/*/src/main.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./node_modules/dmg-core/biome-plugins/arc-09-no-env.grit"]
    },
    {
      "includes": ["domain/**", "!**/*.test.ts"],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/dom-12-no-iso-dates.grit"
      ]
    },
    {
      "includes": [
        "platform/*/src/**",
        "domain/src/**",
        "modules/*/src/**",
        "authoring/*/src/**",
        "runners/**",
        "!**/*.test.ts",
        "!**/*.repo.ts",
        "!**/*-repo.ts",
        "!**/*.json-repo.ts",
        "!**/*.memory-repo.ts"
      ],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/dom-17-snapshot-repo-only.grit"
      ]
    },
    {
      "includes": ["domain/**/*.state.ts"],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/dom-11-base-fields.grit"
      ]
    },
    {
      "includes": [
        "domain/**/*.ar.ts",
        "domain/**/*.dcs.ts",
        "domain/**/*.facade.ts",
        "domain/**/*.uc.ts",
        "domain/**/*.er.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./node_modules/dmg-core/biome-plugins/err-01-no-throw.grit"]
    },
    {
      "includes": [
        "domain/**/*.ar.ts",
        "domain/**/*.dcs.ts",
        "domain/**/*.facade.ts",
        "domain/**/*.uc.ts",
        "domain/**/*.er.ts",
        "domain/**/*.job.ts",
        "!**/*.test.ts"
      ],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/api-02-no-manual-publish.grit"
      ]
    },
    {
      "includes": ["modules/*/src/**/*.uc.ts", "!**/*.test.ts"],
      "plugins": [
        "./node_modules/dmg-core/biome-plugins/api-07-no-call-in-load.grit"
      ]
    }
  ]
}
